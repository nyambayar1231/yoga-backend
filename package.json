{
  "name": "school-cms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "seed": "node --env-file=.env src/seed/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "email:test": "node --env-file=.env src/scripts/send-test-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.9.1",
    "bcrypt": "^6.0.0",
    "hono": "^4.6.20",
    "mongoose": "^9.9.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
