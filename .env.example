NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/school-cms

# Only needed when the frontend is on a different origin than this API (no
# shared parent domain to fall back to same-site cookies with). Comma-separated.
# Leave unset in dev: the Vite proxy keeps the browser on one origin there.
# ALLOWED_ORIGINS=https://your-frontend.pages.dev

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_TTL_SECONDS=604800

# npm run seed - creates the first admin login.
# Add --force to reset the password of an admin that already exists.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Secret@1234

# https://resend.com/api-keys - leave unset in dev to log emails instead of sending
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend
EMAIL_FROM=Yoga Studio <no-reply@example.com>

# Direct-to-S3 uploads. Credentials come from the AWS default chain:
# these two env vars locally, the EC2 instance role in production.
AWS_REGION=ap-southeast-1
S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: key prefix and how long an upload URL stays valid.
# S3_PREFIX=uploads
# S3_UPLOAD_TTL_SECONDS=900
# Only for MinIO/LocalStack or another S3-compatible store, never for AWS.
# S3_ENDPOINT=http://127.0.0.1:9000
